    },
    {
      "id": "yRM5XpoJFi5fsBMNAPiR2",
      "type": "text",
      "x": 1271.8096011839073,
      "y": -1753.0880831248428,
      "width": 556.7196044921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0eV",
      "roundness": null,
      "seed": 259617926,
      "version": 588,
      "versionNonce": 1727817591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760554139615,
      "link": null,
      "locked": false,
      "text": "Game starts as a regular RPG. You are a servant of the\nking, on leave back home in your small town. Today is the\nday workers from the city arrive to investigate a new\ndungeon found under the town. They unleashes hell from\nthe dungeon bellow.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "hqOgsTagnRX6u6Zi9PPmP",
      "originalText": "Game starts as a regular RPG. You are a servant of the king, on leave back home in your small town. Today is the day workers from the city arrive to investigate a new dungeon found under the town. They unleashes hell from the dungeon bellow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lliWLro8hVZl7NFMmdLJu",
      "type": "rectangle",
      "x": 1167.3651567394627,
      "y": -1574.9644242333711,
      "width": 796.6666666666667,
      "height": 115.55555555555544,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
